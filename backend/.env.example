NODE_ENV=development
PORT=9000

# Database
# Local PostgreSQL: postgresql://username:password@localhost:5432/database_name
# Cloud Neon: postgresql://user:password@ep-xxxxx.region.aws.neon.tech/database?sslmode=require
DATABASE_URL="postgresql://fundi:fundi_dev_pass@localhost:5432/fundi_db"

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Groq API (for AI post polish)
GROQ_API_KEY=your_groq_api_key_here

# Firebase Admin — verifies the Firebase ID token from "Continue with Google"
# (POST /auth/google). Use the SAME Firebase project as the client web config.
# Service account: Firebase Console → Project settings → Service accounts → Generate key.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
