{
  "name": "fundi-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize db:migrate",
    "migrate:undo": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize db:migrate:undo",
    "migrate:undo:all": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize db:migrate:undo:all",
    "seed": "NODE_OPTIONS=--no-network-family-autoselection npx sequelize db:seed:all",
    "db:reset": "npm run migrate:undo:all && npm run migrate && npm run seed"
  },
  "dependencies": {
    "@sentry/node": "^8.55.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.9.0",
    "groq-sdk": "^0.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "resend": "^6.12.3",
    "sequelize": "^6.37.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "typesense": "^3.0.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/sequelize": "^4.28.20",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.3",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
